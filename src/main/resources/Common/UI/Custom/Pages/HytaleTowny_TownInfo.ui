          }

          // Pagination Controls
          Group #PaginationControls {
            LayoutMode: Left;
            Anchor: (Top: 10);

            $C.@SmallSecondaryTextButton #PrevPageButton {
              Text: "Previous";
              Anchor: (Right: 10);
            }

            $C.@SmallSecondaryTextButton #NextPageButton {
              Text: "Next";
            }
          }

          // Action Buttons for Selected Resident
          Group #ResidentActions {
            LayoutMode: Left;
            Anchor: (Top: 10);
            Visible: false;

            $C.@SecondaryTextButton #PromoteButton {
              Text: "Promote";
              Anchor: (Right: 10);
            }

            $C.@SecondaryTextButton #DemoteButton {
              Text: "Demote";
              Anchor: (Right: 10);
              Visible: false;
            }

            $C.@CancelTextButton #KickButton {
              Text: "Kick";
              Anchor: (Right: 10);
            }

            $C.@TextButton #TransferMayorButton {
              Text: "Make Mayor";
              Visible: false;
            }
          }
        }
      }
    }
  }
}

$C.@BackButton {}
