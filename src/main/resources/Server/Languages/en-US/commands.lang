town.join_closed = Town '{name}' is not open. You need an invite.
town.not_open = You cannot join this town. You need an invite.
town.not_mayor = Only the mayor can do this
town.not_leader = Only the mayor or assistants can do this
town.cant_claim_here = You cannot create a town here - this area is already claimed
town.spawn_not_set = Town spawn has not been set
town.must_be_in_territory = You must be in your town's territory to do this
town.mayor_cant_leave = The mayor cannot leave the town. Delete it or transfer mayorship first
town.no_money = You need {amount} to create a town (you have {balance})
town.withdraw_failed = Failed to withdraw money from your account
town.deposit_failed = Failed to deposit to town bank
town.not_enough_money = You don't have enough money
town.town_no_money = Town doesn't have enough money
town.player_not_found = Player '{name}' not found
town.player_not_in_town = '{name}' is not a member of your town
town.already_assistant = '{name}' is already an assistant
town.not_assistant = '{name}' is not an assistant
town.cant_kick_mayor = You cannot kick the mayor
town.invalid_color = Invalid color format. Use 6-digit hex color (e.g., FF0000)
town.invalid_value = Invalid value. Use: {valid_values}

# Info messages
town.use_town_commands = Use /town for town commands
town.new_balance = New town balance: {amount}
town.closed_invite_only = This town is closed (invite only)

