town.toggle_public = Town is now {public_private}
town.toggle_open = Town is now {open_closed}. {info_message}
town.refunded = Town balance of {amount} refunded to you

# Error messages
town.name_blank = Town name cannot be blank
town.name_too_long = Town name too long (max {max} characters)
town.already_in_town = You are already a member of a town
town.not_found = Town '{name}' not found
town.not_in_town = You are not a member of any town
