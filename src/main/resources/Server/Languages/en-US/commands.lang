# ===== Town Commands =====
# Success messages
town.created = Town '{name}' created successfully!
town.deleted = Town '{name}' has been deleted
town.joined = You have joined town '{name}'!
town.left = You have left town '{name}'
town.spawn_set = Town spawn set to your current location
town.spawn_teleported = Teleported to {town} spawn
town.deposited = Deposited {amount} to town bank
town.withdrew = Withdrew {amount} from town bank
town.color_set = Town color updated to {color}
town.kicked = Kicked '{player}' from the town
town.invited = Invited '{player}' to join town '{town}'
town.invite_received = You have been invited to join town '{town}'!
town.invite_how_to_accept = Type /accept {inviteId} or /accept {town} to accept
town.invite_check_invites = Type /invite list to see all your invitations
town.promoted = Promoted '{player}' to assistant
town.demoted = Demoted '{player}' from assistant
town.toggle_pvp = PvP {enabled_disabled} for town '{town}'
